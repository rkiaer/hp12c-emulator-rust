<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibraryImport gera código com ponteiros. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Hp12c</RootNamespace>
  </PropertyGroup>

  <!-- DLL do núcleo em Rust: gerar antes com "cargo build (release) -p hp12c-ffi" (ver README). -->
  <ItemGroup>
    <None Include="..\..\target\release\hp12c_ffi.dll" Link="hp12c_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
