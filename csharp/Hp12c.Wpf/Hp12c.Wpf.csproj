<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>HP12C.Wpf</AssemblyName>
    <RootNamespace>Hp12c.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hp12c.Interop\Hp12c.Interop.csproj" />
    <!-- Mesmo skin da versão Rust. -->
    <None Include="..\..\assets\skin.json" Link="skin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
